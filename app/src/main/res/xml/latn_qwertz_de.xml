<?xml version='1.0' encoding='utf-8'?>
<keyboard name="QWERTZ (Deutsch)" script="latin">
  <row>
    <key c="q" se="esc" />
    <key c="w" ne="2" sw="&quot;" se="\@" />
    <key c="e" ne="3" sw="!" se="€" />
    <key c="r" />
    <key c="t" sw="f11" />
    <key c="z" ne="home" sw="page_up" nw="f12" />
    <key c="u" ne="end" sw="{" nw="page_down" />
    <key c="i" ne="8" sw="[" nw="insert" />
    <key c="o" ne="9" sw="(" se=")" />
    <key c="p" ne="0" sw="=" />
    <key c="ü" sw="\?" />
  </row>
  <row>
    <key c="a" ne="tab" />
    <key c="s" nw="`" sw="ß" />
    <key c="d" />
    <key c="f" nw="~" />
    <key c="g" sw="-" />
    <key c="h" sw="+" />
    <key c="j" sw="*" />
    <key c="k" sw="/" />
    <key c="l" nw="'" sw="\\" />
    <key c="ö" sw="\#" />
    <key c="ä" />
  </row>
  <row>
    <key width="1.5" role="action" c="shift" ne="capslock" />
    <key shift="0.5" c="y" nw="&gt;" ne="|" sw="&lt;" />
    <key c="x" nw="†" />
    <key c="c" />
    <key c="v" />
    <key c="b" nw=";" sw="," />
    <key c="n" nw=":" sw="." />
    <key c="m" nw="_" />
    <key shift="0.5" width="1.5" role="action" c="backspace" ne="delete" />
  </row>
</keyboard>