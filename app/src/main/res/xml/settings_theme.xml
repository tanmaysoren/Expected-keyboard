        <expected.keyboard2.prefs.ColorPickerPreference android:key="custom_theme_color_letters" android:title="@string/pref_custom_color_letters" android:defaultValue="-986375"/>
        <expected.keyboard2.prefs.ColorPickerPreference android:key="custom_theme_color_key_bg" android:title="@string/pref_custom_color_key_bg" android:defaultValue="-15394520"/>
        <expected.keyboard2.prefs.ColorPickerPreference android:key="custom_theme_color_keyboard_bg" android:title="@string/pref_custom_color_keyboard_bg" android:defaultValue="-15920866"/>
        <expected.keyboard2.prefs.ColorPickerPreference android:key="custom_theme_color_action" android:title="@string/pref_custom_color_action" android:defaultValue="-13951922"/>
        <expected.keyboard2.prefs.ColorPickerPreference android:key="custom_theme_color_activated" android:title="@string/pref_custom_color_activated" android:defaultValue="-12903314"/>
        <expected.keyboard2.prefs.ColorPickerPreference android:key="custom_theme_color_spacebar" android:title="@string/pref_custom_color_spacebar" android:defaultValue="-14933448"/>
        <expected.keyboard2.prefs.ColorPickerPreference android:key="custom_theme_color_sublabel" android:title="@string/pref_custom_color_sublabel" android:defaultValue="-7036008"/>
        <expected.keyboard2.prefs.IntSlideBarPreference android:key="custom_theme_bg_opacity" android:title="@string/pref_custom_bg_opacity" android:summary="%s%%" android:defaultValue="100" min="0" max="100"/>
      </PreferenceCategory>
    </PreferenceScreen>
    <expected.keyboard2.prefs.IntSlideBarPreference android:key="label_brightness" android:title="@string/pref_label_brightness" android:summary="%s%%" android:defaultValue="100" min="50" max="100"/>
    <expected.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_opacity" android:title="@string/pref_keyboard_opacity" android:summary="%s%%" android:defaultValue="100" min="0" max="100"/>
    <expected.keyboard2.prefs.IntSlideBarPreference android:key="key_opacity" android:title="@string/pref_key_opacity" android:summary="%s%%" android:defaultValue="100" min="0" max="100"/>
    <expected.keyboard2.prefs.IntSlideBarPreference android:key="key_activated_opacity" android:title="@string/pref_key_activated_opacity" android:summary="%s%%" android:defaultValue="100" min="0" max="100"/>
    <PreferenceScreen android:title="@string/pref_margin_bottom_title">
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="margin_bottom_portrait" android:title="@string/pref_portrait" android:summary="%sdp" android:defaultValue="7" min="0" max="250"/>
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="margin_bottom_landscape" android:title="@string/pref_landscape" android:summary="%sdp" android:defaultValue="3" min="0" max="120"/>
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="margin_bottom_portrait_unfolded" android:title="@string/pref_portrait_unfolded" android:summary="%sdp" android:defaultValue="7" min="0" max="250"/>
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="margin_bottom_landscape_unfolded" android:title="@string/pref_landscape_unfolded" android:summary="%sdp" android:defaultValue="3" min="0" max="250"/>
    </PreferenceScreen>
    <PreferenceScreen android:title="@string/pref_keyboard_height_title">
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_height" android:title="@string/pref_portrait" android:summary="%s%%" android:defaultValue="25" min="10" max="100"/>
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_height_landscape" android:title="@string/pref_landscape" android:summary="%s%%" android:defaultValue="50" min="20" max="65"/>
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_height_unfolded" android:title="@string/pref_portrait_unfolded" android:summary="%s%%" android:defaultValue="25" min="10" max="50"/>
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_height_landscape_unfolded" android:title="@string/pref_landscape_unfolded" android:summary="%s%%" android:defaultValue="50" min="20" max="65"/>
    </PreferenceScreen>
    <PreferenceScreen android:title="@string/pref_horizontal_margin_title">
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="horizontal_margin_portrait" android:title="@string/pref_portrait" android:summary="%sdp" android:defaultValue="3" min="0" max="30"/>
      <expected.keyboard2.prefs.IntSlideBarPreference android:key="horizontal_margin_landscape" android:title="@string/pref_landscape" android:summary="%sdp" android:defaultValue="28" min="0" max="200"/>
