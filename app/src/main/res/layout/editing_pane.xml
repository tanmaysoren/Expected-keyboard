<?xml version="1.0" encoding="utf-8"?>
<expected.keyboard2.EditingPaneView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorKeyboard"
    android:padding="6dp">

    <!-- Top Action Toolbar: Back, Undo, Redo, Select All, Cut, Copy, Paste -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/normal_btn_bg"
        android:paddingHorizontal="4dp"
        android:layout_marginBottom="6dp">

        <ImageButton
            android:id="@+id/edit_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_futo_chevron_left"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editing_back"
            android:tint="?attr/colorLabel"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/editing_heading"
            android:textColor="?attr/colorLabel"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <ImageButton
            android:id="@+id/edit_btn_undo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_futo_undo"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editing_undo"
            android:tint="?attr/colorLabel"/>

        <ImageButton
            android:id="@+id/edit_btn_redo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_futo_redo"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editing_redo"
            android:tint="?attr/colorLabel"/>

        <ImageButton
            android:id="@+id/edit_btn_cut"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_futo_cut"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editing_cut"
            android:tint="?attr/colorLabel"/>

        <ImageButton
            android:id="@+id/edit_btn_copy"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_futo_copy"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editing_copy"
            android:tint="?attr/colorLabel"/>

        <ImageButton
            android:id="@+id/edit_btn_paste"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_clipboard_paste"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editing_paste"
            android:tint="?attr/colorLabel"/>
    </LinearLayout>

    <!-- Navigation & Controller Matrix -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Row 1: Line Start, Page Up, Arrow Up, Page Down, Line End -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/edit_btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="⇤"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <Button
                android:id="@+id/edit_btn_page_up"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="PgUp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <ImageButton
                android:id="@+id/edit_btn_up"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:layout_margin="2dp"
                android:src="@drawable/ic_futo_arrow_up"
                android:tint="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <Button
                android:id="@+id/edit_btn_page_down"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="PgDn"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <Button
                android:id="@+id/edit_btn_end"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="⇥"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>
        </LinearLayout>

        <!-- Row 2: Word Left, Arrow Left, SELECT MODE, Arrow Right, Word Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/edit_btn_word_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="◀◀"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <ImageButton
                android:id="@+id/edit_btn_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:layout_margin="2dp"
                android:src="@drawable/ic_futo_arrow_left"
                android:tint="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <TextView
                android:id="@+id/edit_btn_select_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:layout_margin="2dp"
                android:text="@string/editing_select"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorLabel"
                android:gravity="center"
                android:background="@drawable/normal_btn_bg"/>

            <ImageButton
                android:id="@+id/edit_btn_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:layout_margin="2dp"
                android:src="@drawable/ic_futo_arrow_right"
                android:tint="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <Button
                android:id="@+id/edit_btn_word_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="▶▶"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>
        </LinearLayout>

        <!-- Row 3: Backspace, Forward Delete, Arrow Down, Select All, Enter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/edit_btn_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:src="@drawable/ic_futo_backspace"
                android:tint="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <Button
                android:id="@+id/edit_btn_delete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="DEL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <ImageButton
                android:id="@+id/edit_btn_down"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:layout_margin="2dp"
                android:src="@drawable/ic_futo_arrow_down"
                android:tint="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <ImageButton
                android:id="@+id/edit_btn_select_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:src="@drawable/ic_futo_select_all"
                android:tint="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>

            <Button
                android:id="@+id/edit_btn_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="⏎"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorLabel"
                android:background="@drawable/normal_btn_bg"/>
        </LinearLayout>
    </LinearLayout>

</expected.keyboard2.EditingPaneView>
