<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <gradient
          android:startColor="#8B5CF6"
          android:endColor="#6366F1"
          android:angle="135"/>
      <stroke android:width="1.5dp" android:color="#C4B5FD"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
  <item android:state_enabled="false">
    <shape android:shape="rectangle">
      <solid android:color="#1A1D2B"/>
      <stroke android:width="1dp" android:color="#2D3349"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <gradient
          android:startColor="#2A2254"
          android:endColor="#1E203C"
          android:angle="135"/>
      <stroke android:width="1.2dp" android:color="#6366F1"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
</selector>
