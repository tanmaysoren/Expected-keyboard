<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="#2E2E2E"/>
      <stroke android:width="1.5dp" android:color="#FFFFFF"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
  <item android:state_enabled="false">
    <shape android:shape="rectangle">
      <solid android:color="#0D0D0D"/>
      <stroke android:width="1dp" android:color="#262626"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#111111"/>
      <stroke android:width="1dp" android:color="#4D4D4D"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
</selector>
