<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Slim recessed rail. The gravity keeps each layer at its 4dp intrinsic
       height instead of stretching it over the SeekBar's 44dp touch area. -->
  <item android:id="@android:id/background" android:gravity="center_vertical">
    <shape android:shape="rectangle">
      <corners android:radius="2dp"/>
      <solid android:color="#0D0D0D"/>
      <stroke android:width="1dp" android:color="#333333"/>
      <size android:height="4dp"/>
    </shape>
  </item>
  <!-- Secondary progress -->
  <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
    <clip>
      <shape android:shape="rectangle">
        <corners android:radius="2dp"/>
        <solid android:color="#4D4D4D"/>
        <size android:height="4dp"/>
      </shape>
    </clip>
  </item>
  <!-- Filled progress -->
  <item android:id="@android:id/progress" android:gravity="center_vertical">
    <clip>
      <shape android:shape="rectangle">
        <corners android:radius="2dp"/>
        <solid android:color="#FFFFFF"/>
        <size android:height="4dp"/>
      </shape>
    </clip>
  </item>
</layer-list>
