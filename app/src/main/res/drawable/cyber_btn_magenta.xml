<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <gradient
          android:startColor="#0284C7"
          android:endColor="#0EA5E9"
          android:angle="135"/>
      <stroke android:width="1.5dp" android:color="#BAE6FD"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
  <item android:state_enabled="false">
    <shape android:shape="rectangle">
      <solid android:color="#1A1D2B"/>
      <stroke android:width="1dp" android:color="#2D3349"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <gradient
          android:startColor="#152642"
          android:endColor="#111B30"
          android:angle="135"/>
      <stroke android:width="1.2dp" android:color="#0EA5E9"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
</selector>
