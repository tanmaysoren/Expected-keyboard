<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <gradient
          android:startColor="#059669"
          android:endColor="#10B981"
          android:angle="135"/>
      <stroke android:width="1.5dp" android:color="#A7F3D0"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
  <item android:state_enabled="false">
    <shape android:shape="rectangle">
      <solid android:color="#1A1D2B"/>
      <stroke android:width="1dp" android:color="#2D3349"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <gradient
          android:startColor="#132B25"
          android:endColor="#101F1D"
          android:angle="135"/>
      <stroke android:width="1.2dp" android:color="#10B981"/>
      <corners android:radius="14dp"/>
      <padding android:left="18dp" android:top="13dp" android:right="18dp" android:bottom="13dp"/>
    </shape>
  </item>
</selector>
