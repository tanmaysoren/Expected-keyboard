<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <solid android:color="#0F121F"/>
      <stroke android:width="1.5dp" android:color="#8B5CF6"/>
      <corners android:radius="12dp"/>
      <padding android:left="16dp" android:top="14dp" android:right="16dp" android:bottom="14dp"/>
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#141726"/>
      <stroke android:width="1dp" android:color="#282E48"/>
      <corners android:radius="12dp"/>
      <padding android:left="16dp" android:top="14dp" android:right="16dp" android:bottom="14dp"/>
    </shape>
  </item>
</selector>
